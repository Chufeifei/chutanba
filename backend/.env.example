# ===== 数据库（MySQL）=====
# 数据库连接配置。生产环境在云托管控制台 / 平台环境变量注入，真实密码不要提交进仓库。
# 数据库主机地址（生产必填，缺失则服务启动直接退出）；本地开发填 127.0.0.1
DB_HOST=
# 数据库端口，默认 3306
DB_PORT=3306
# 数据库账号（生产必填）
DB_USER=
# 数据库密码
DB_PASSWORD=
# 数据库名（生产必填）
DB_NAME=
# 数据库连接池最大连接数，默认 10
DB_CONNECTION_LIMIT=10
# 是否通过 TLS 连接数据库；仅当云端 MySQL 要求加密连接时设 true
DB_SSL=false

# ===== 服务基础 =====
# 服务监听端口。云托管平台会注入实际 PORT 覆盖此值；本地开发建议改成 3000
PORT=80
# 运行环境：development（开发）/ production（生产）。生产缺库配置会直接退出、安全密钥无兜底
NODE_ENV=development

# 小程序本地联调 API 地址（标量配置示例）。填写后应将相同值同步到 miniprogram/config/cloud.js
# 的 localBaseUrl，并将 serviceName 留空；serviceName 有值时强制请求云托管。
# 小程序运行时无法直接读取 backend/.env。
# 开发者工具示例：http://127.0.0.1:3000；真机请使用电脑的局域网 IP。
MINIPROGRAM_LOCAL_BASE_URL=

# ===== 服务端安全密钥 =====
# 生产环境必须由密钥管理 / 平台环境变量注入，切勿在此填写真实值，也不要提交仓库。
# 预约核销码签名密钥（HMAC-SHA256）。生产缺失则生成核销码直接报错。生成命令：openssl rand -hex 32
QR_TOKEN_SECRET=
# 手机号加密主密钥（AES-256-GCM），必须正好 32 字节。生成：openssl rand -hex 32 或 openssl rand -base64 32。缺失则无法保存手机号
ACCOUNT_PII_KEY=

# ===== 微信小程序 =====
# 用于 getPhoneNumber 授权码换取用户手机号
# 微信小程序 AppID
WECHAT_APP_ID=
# 微信小程序 AppSecret（服务端保密，不要泄露）
WECHAT_APP_SECRET=

# ===== 微信公众号（订阅号 / 服务号）=====
# 用于向摊主 / 运营推送「预约汇总」模板消息。以下密钥均保存在服务端，不要泄露。
# 公众号 AppID
WECHAT_OA_APP_ID=
# 公众号 AppSecret
WECHAT_OA_APP_SECRET=
# 公众号消息回调 Token（服务器配置校验用）
WECHAT_OA_CALLBACK_TOKEN=
# 公众号消息回调 EncodingAESKey（消息加解密用）
WECHAT_OA_ENCODING_AES_KEY=
# 预约汇总模板消息的模板 ID
WECHAT_OA_RESERVATION_DIGEST_TEMPLATE_ID=
# 逻辑字段名 → 模板关键词 ID 映射（如 thing1 / date2 ...），按你公众号实际申请的模板调整
WECHAT_OA_RESERVATION_DIGEST_FIELDS_JSON={"vendorName":"thing1","businessDate":"date2","newReservationCount":"number3","totalReservationCount":"number4"}
# 公众号展示名称（绑定引导页用）
WECHAT_OA_DISPLAY_NAME=
# 公众号二维码图片地址（绑定引导页用）
WECHAT_OA_QR_IMAGE_URL=
# 模板消息跳转的小程序 AppID；留空则自动回退到 WECHAT_APP_ID
WECHAT_MINIPROGRAM_APP_ID=

# ===== 事务消息（Outbox）投递与定时调度 =====
# 内置已处理「预约汇总」事件，其他事件类型需自行提供投递器。
# 自定义投递器模块路径（相对或绝对），须导出 async deliver(event) 函数；只用到预约汇总推送时可留空
OUTBOX_DELIVERER_MODULE=
# 每次批处理最多投递的事件条数，默认 100（限 1–1000）
OUTBOX_BATCH_SIZE=100

# 定时调度端点令牌。生产必填：云托管定时任务通过它调用 /internal/jobs/*。
# 未配置时调度端点统一返回 503（宁可不可用，也不允许匿名触发作业）。生成命令：openssl rand -hex 32
JOB_TRIGGER_TOKEN=
# 单次调度请求的时间预算（毫秒），默认 20000。必须小于平台 HTTP 请求超时，
# 到期主动收手并在返回摘要中标记 budgetExhausted，剩余部分由下一次调度继续处理。
JOB_TIME_BUDGET_MS=20000

# ===== 运营权限 =====
# 管理端写操作（如区域字典维护）白名单，填运营人员的微信 openid，英文逗号分隔。
# 未配置时管理端写能力视为「未开放」，接口统一返回 503 MANAGEMENT_NOT_CONFIGURED，
# 而不是允许任意请求写入——宁可不可用，也不裸奔。
# 身份本身来自云托管注入的 X-WX-OPENID，绝不信任请求体中的 openid 或 role。
ADMIN_OPERATOR_OPENIDS=
