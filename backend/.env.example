# ===== 数据库（MySQL）=====
# 数据库连接配置。生产环境在云托管控制台 / 平台环境变量注入，真实密码不要提交进仓库。
# 数据库主机地址（生产必填，缺失则服务启动直接退出）；本地开发填 127.0.0.1
DB_HOST=
# 数据库端口，默认 3306
DB_PORT=3306
# 数据库账号（生产必填）
DB_USER=
# 数据库密码
DB_PASSWORD=
# 数据库名（生产必填）
DB_NAME=
# 数据库连接池最大连接数，默认 10
DB_CONNECTION_LIMIT=10
# 是否通过 TLS 连接数据库；仅当云端 MySQL 要求加密连接时设 true
DB_SSL=false

# ===== 服务基础 =====
# 服务监听端口。云托管平台会注入实际 PORT 覆盖此值；本地开发建议改成 3000
PORT=80
# 运行环境：development（开发）/ production（生产）。生产环境不返回错误堆栈与详情
NODE_ENV=development

# 小程序本地联调 API 地址（标量配置示例）。填写后应将相同值同步到 miniprogram/config/cloud.js
# 的 localBaseUrl，并将 serviceName 留空；serviceName 有值时强制请求云托管。
# 小程序运行时无法直接读取 backend/.env。
# 开发者工具示例：http://127.0.0.1:3000；真机请使用电脑的局域网 IP。
MINIPROGRAM_LOCAL_BASE_URL=

# ===== 定时调度 =====
# 定时调度端点令牌。生产必填：云托管定时任务通过它调用 /internal/jobs/*。
# 未配置时调度端点统一返回 503（宁可不可用，也不允许匿名触发作业）。生成命令：openssl rand -hex 32
JOB_TRIGGER_TOKEN=
# 单次调度请求的时间预算（毫秒），默认 20000。必须小于平台 HTTP 请求超时，
# 到期主动收手并在返回摘要中标记 budgetExhausted，剩余部分由下一次调度继续处理。
JOB_TIME_BUDGET_MS=20000

# ===== 身份与授权名单 =====
# 管理资格只由部署配置指定：填微信 openid，英文逗号分隔；不在管理界面授予。
# 未配置的名单不会授予任何资格，接口按无权限拒绝（403 PERMISSION_DENIED），
# 而不是回退成"任意请求都可写"。身份本身来自云托管注入的 X-WX-OPENID，
# 绝不信任请求体或查询参数中的 openid / role / user_id。
SUPER_ADMIN_OPENIDS=
ADMIN_OPENIDS=
PROFILE_REVIEWER_OPENIDS=
FIELD_REVIEWER_OPENIDS=

# ===== 本地身份模拟 =====
# 仅非生产环境生效：设为 true 时才接受 X-Dev-Openid 请求头用于本地联调。
# 生产环境无论该值如何都忽略 X-Dev-Openid；默认关闭，避免误配后自动信任模拟身份。
ALLOW_DEV_IDENTITY=false

# ===== 定位上下文令牌 =====
# 一次性定位上下文的 HMAC 签名密钥。生产必填：未配置时签发接口返回 503（SERVICE_UNAVAILABLE），
# 已有轮次与公开控制的读接口不受影响。轮换密钥会让所有未消费的令牌立即失效。
# 生成命令：openssl rand -hex 32
LOCATION_CONTEXT_SECRET=

# ===== 公开匿名会话令牌 =====
# 公开匿名会话与观察领取令牌的 HMAC 签名密钥。生产必填：未配置时 /public 写端点返回 503；
# 品类、公开集合与详情仍可读。轮换密钥会让未消费的匿名会话与领取令牌失效。
# 生成命令：openssl rand -hex 32
PUBLIC_TOKEN_SECRET=
# 匿名会话令牌有效期（毫秒），默认 1800000（30 分钟）。只影响令牌复用。
PUBLIC_SESSION_TTL_MS=1800000
# 公开集合单次可返回上限，默认 200。超过即返回 503 SNAPSHOT_TOO_LARGE，绝不截断。
PUBLIC_SNAPSHOT_MAX=200
