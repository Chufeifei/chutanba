.nav-shell {
  position: fixed;
  z-index: 1000;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 12rpx calc(12rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.nav-card {
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 1rpx solid #f3d0c2;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 28rpx rgba(98, 67, 56, 0.08);
  pointer-events: auto;
}

.nav-item {
  width: 20%;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9a8178;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 26rpx;
}

.nav-icon-wrap {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.nav-icon {
  width: 42rpx;
  height: 42rpx;
  opacity: .72;
}

.nav-item.active {
  color: #ff6f5c;
  background: #fff4ee;
}

.nav-item.active .nav-icon {
  width: 46rpx;
  height: 46rpx;
  opacity: 1;
  transform: translateY(-2rpx);
}
