.tab-bar { position: fixed; z-index: 1000; right: 0; bottom: 0; left: 0; height: calc(132rpx + env(safe-area-inset-bottom)); padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); background: #FAF8F5; box-sizing: border-box; }.tab-pill { display: flex; height: 100rpx; padding: 6rpx; border: 1rpx solid #F0ECE8; border-radius: 52rpx; background: #FFFFFF; box-sizing: border-box; }.tab-item { display: flex; flex: 1; align-items: center; justify-content: center; gap: 10rpx; border-radius: 44rpx; color: #77746F; font-size: 22rpx; }.tab-item.active { background: #FF7A45; color: #FFFFFF; font-weight: 600; }.tab-icon { width: 28rpx; height: 28rpx; opacity: .72; }.tab-item.active .tab-icon { opacity: 1; filter: brightness(0) invert(1); }