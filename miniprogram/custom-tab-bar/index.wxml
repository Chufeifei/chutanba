<view class="tab-bar">
  <view class="tab-pill">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <image class="tab-icon" src="/assets/icons/feather/{{selected === index ? item.activeIcon : item.icon}}.svg" />
      <text>{{item.text}}</text>
    </view>
  </view>
</view>
