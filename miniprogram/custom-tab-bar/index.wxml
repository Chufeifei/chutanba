<view class="nav-shell">
  <view class="nav-card">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="nav-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="nav-icon-wrap">
        <image class="nav-icon" src="{{item.iconPath}}" mode="aspectFit" />
      </view>
      <text class="nav-label">{{item.text}}</text>
    </view>
  </view>
</view>
