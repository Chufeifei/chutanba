.hero {
  position: relative;
  min-height: 286rpx;
  overflow: hidden;
  padding: 34rpx 32rpx 30rpx;
  background: linear-gradient(135deg, #fff0e5 0%, #fff7ed 57%, #e9f6ef 100%);
}

.hero-orb {
  position: absolute;
  top: -92rpx;
  right: -68rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 174, 134, 0.22);
}

.hero-content {
  position: relative;
  z-index: 2;
  width: 520rpx;
}

.brand-pill {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.92);
  color: #ec6d55;
  font-size: 21rpx;
  font-weight: 850;
  letter-spacing: 1rpx;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  color: #765c53;
  line-height: 1.6;
}

.location-pill {
  min-height: 66rpx;
  display: inline-flex;
  align-items: center;
  max-width: 500rpx;
  margin-top: 20rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(240,202,187,.8);
  border-radius: 999rpx;
  background: rgba(255,255,255,.82);
  color: #6c514a;
  font-size: 23rpx;
  font-weight: 700;
}

.location-pill image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.hero-icon-card {
  position: absolute;
  z-index: 2;
  right: 30rpx;
  top: 82rpx;
  width: 132rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,.92);
  border-radius: 34rpx;
  background: rgba(255,255,255,.84);
  box-shadow: 0 12rpx 30rpx rgba(91,62,50,.07);
}

.hero-icon-card image {
  width: 88rpx;
  height: 88rpx;
}

.feature-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.feature-card {
  width: calc((100% - 42rpx) / 4);
  min-height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 8rpx;
  background: #fffaf7;
}

.feature-card.selected {
  border-color: #9bd8c2;
  background: #effaf5;
}

.feature-icon-wrap {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon-wrap image {
  width: 52rpx;
  height: 52rpx;
}

.feature-label {
  margin-top: 8rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.feature-sub {
  margin-top: 4rpx;
  color: #9a8178;
  font-size: 18rpx;
}

.search-box {
  height: 94rpx;
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 0 24rpx;
}

.search-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  height: 100%;
}

.clear {
  width: 54rpx;
  text-align: center;
  color: #aa8b81;
  font-size: 42rpx;
}

.category-heading {
  margin-bottom: 14rpx;
}

.category-scroll {
  width: calc(100% + 24rpx);
  margin-right: -24rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  padding-right: 24rpx;
}

.category-item {
  width: 146rpx;
  min-height: 130rpx;
  margin-right: 14rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #f1d1c5;
  border-radius: 24rpx;
  background: #fffaf7;
  color: #735b54;
  font-size: 21rpx;
  font-weight: 700;
}

.category-item.active {
  border-color: #ff9b82;
  background: #fff0e8;
  color: #ec654f;
  box-shadow: inset 0 0 0 1rpx #ffb39f;
}

.category-icon-wrap {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 7rpx;
}

.category-icon-wrap image {
  width: 58rpx;
  height: 58rpx;
}

.empty-image {
  display: block;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
}

.empty-btn {
  margin: 28rpx auto 0;
}
