<view class="page-no-nav">
  <view class="vendor-hero card">
    <view class="hero-copy">
      <view class="brand-pill">VENDOR PROFILE</view>
      <text class="hero-title">完善一次，之后自动填写</text>
      <text class="hero-desc">把常卖品类、菜单、价格和常用地点存成模板，发布新一场时直接带入。</text>
    </view>
    <view class="hero-icon-card">
      <image src="/assets/icons/vendor.png" mode="aspectFit" />
    </view>
  </view>

  <view class="profile-card card">
    <view class="section-head">
      <image src="/assets/icons/nav-mine.png" mode="aspectFit" />
      <view>
        <text class="section-main">摊主名片</text>
        <text class="section-sub">顾客会在摊位详情中看到这些信息</text>
      </view>
    </view>

    <button class="avatar-button" bindtap="chooseAvatar">
      <view class="avatar-box">
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
        <image wx:else src="/assets/icons/vendor.png" mode="aspectFit" />
      </view>
      <text class="avatar-edit">点击更换头像</text>
    </button>

    <view class="form-item">
      <text class="form-label required">摊主名称</text>
      <input class="input" maxlength="30" value="{{name}}" placeholder="例如：阿圆饭团" data-field="name" bindinput="input" />
    </view>

    <view class="form-item">
      <text class="form-label">摊主简介</text>
      <textarea class="textarea" maxlength="200" value="{{intro}}" placeholder="简单介绍你做什么、通常在哪些区域出摊…" data-field="intro" bindinput="input" />
    </view>
  </view>

  <view class="profile-card card">
    <view class="section-head">
      <image src="/assets/icons/edit.png" mode="aspectFit" />
      <view>
        <text class="section-main">出摊自动带入</text>
        <text class="section-sub">发布页会优先使用下面的常用资料</text>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">默认本场名称</text>
      <input class="input" maxlength="30" value="{{defaultStallName}}" placeholder="例如：阿圆饭团今晚出摊" data-field="defaultStallName" bindinput="input" />
      <text class="hint">不填写时，会自动使用“摊主名称 + 今天出摊”。</text>
    </view>

    <view class="form-item">
      <text class="form-label required">常卖品类</text>
      <view class="category-grid">
        <view
          wx:for="{{categories}}"
          wx:key="value"
          class="category-option {{categoryIndex === index ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="chooseCategory"
        >
          <view class="category-option-icon">
            <image src="{{item.icon}}" mode="aspectFit" />
          </view>
          <text>{{item.value}}</text>
        </view>
      </view>
      <input
        wx:if="{{customMode}}"
        class="input custom-category"
        maxlength="20"
        placeholder="自由填写品类，例如：贵州糯米饭"
        value="{{customCategory}}"
        bindinput="inputCustomCategory"
      />
    </view>

    <view class="form-item">
      <text class="form-label">默认本场介绍</text>
      <textarea class="textarea" maxlength="300" value="{{defaultDescription}}" placeholder="例如：现做现卖，每天数量不多，卖完会及时更新。" data-field="defaultDescription" bindinput="input" />
    </view>

    <view class="form-item">
      <text class="form-label">常用菜单</text>
      <input class="input" maxlength="100" value="{{defaultMenuText}}" placeholder="例如：紫米饭团 / 卤蛋 / 柠檬茶" data-field="defaultMenuText" bindinput="input" />
    </view>

    <view class="form-item">
      <text class="form-label">常用价格说明</text>
      <input class="input" maxlength="50" value="{{defaultPriceText}}" placeholder="例如：人均约 8-15 元" data-field="defaultPriceText" bindinput="input" />
    </view>

    <view class="form-item">
      <text class="form-label">常用公告</text>
      <textarea class="textarea small" maxlength="120" value="{{defaultNotice}}" placeholder="例如：数量有限，卖完会及时更新。" data-field="defaultNotice" bindinput="input" />
    </view>

    <view class="form-item">
      <text class="form-label">常用出摊地点</text>
      <button class="place-btn" bindtap="chooseCommonPlace">
        <view class="place-main">
          <image src="/assets/icons/location.png" mode="aspectFit" />
          <text class="place-text">{{commonAddress || '点击地图选择常用地点'}}</text>
        </view>
        <text class="place-arrow">›</text>
      </button>
      <text class="hint">以后发布出摊时会自动带入，临时换地方仍可单独修改。</text>
    </view>

    <view class="safe-note">
      公开资料请勿填写手机号、微信号、二维码等敏感联系方式。顾客可通过关注摊主和地图导航获取信息。
    </view>

    <button class="primary-btn save-btn" loading="{{saving}}" bindtap="save">保存并用于自动填写</button>
  </view>
</view>
