.profile {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #fff0e5, #f0faf5);
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-right: 22rpx;
  border-radius: 34rpx;
  background: rgba(255,255,255,.86);
  box-shadow: 0 8rpx 20rpx rgba(91, 58, 47, 0.09);
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar image[mode="aspectFit"] {
  width: 78rpx;
  height: 78rpx;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-pill {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #ef6d56;
  font-size: 18rpx;
  font-weight: 850;
  letter-spacing: 1rpx;
}

.profile-name,
.profile-desc {
  display: block;
}

.profile-name {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.profile-desc {
  margin-top: 6rpx;
  overflow: hidden;
  color: #80675f;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  color: #b5968c;
  font-size: 44rpx;
}

.stats {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
}

.stat {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.stat.mint {
  border-color: #bfe5d6;
  background: #f0fbf6;
}

.stat image {
  width: 58rpx;
  height: 58rpx;
  margin-right: 16rpx;
}

.stat-number,
.stat-label {
  display: block;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 900;
}

.stat-number.coral {
  color: #ff7561;
}

.stat-number.green {
  color: #39a886;
}

.stat-label {
  margin-top: 3rpx;
  color: #80675f;
  font-size: 22rpx;
}

.menu {
  overflow: hidden;
  margin-top: 20rpx;
}

.menu-item {
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 26rpx;
  border-bottom: 1rpx solid #f5e2da;
  font-weight: 700;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-box {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border-radius: 18rpx;
  background: #fff0e8;
}

.menu-icon-box.mint {
  background: #e9f7f0;
}

.menu-icon-box image {
  width: 42rpx;
  height: 42rpx;
}

.developer {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 24rpx;
}

.developer > image {
  width: 58rpx;
  height: 58rpx;
  margin-right: 16rpx;
}

.developer-copy {
  flex: 1;
  min-width: 0;
}

.developer-label,
.developer-value {
  display: block;
}

.developer-label {
  color: #8f746c;
  font-size: 22rpx;
}

.developer-value {
  margin-top: 8rpx;
  overflow: hidden;
  font-family: monospace;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.version {
  display: block;
  padding: 32rpx 0 0;
  text-align: center;
  color: #b39b93;
  font-size: 21rpx;
}

.identity-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.identity-role {
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: #eaf8f2;
  color: #319677;
  font-size: 17rpx;
  font-weight: 850;
}

.identity-role.super {
  background: #fff0e9;
  color: #ef654f;
}

.identity-warning {
  display: block;
  margin-top: 7rpx;
  color: #d16b5e;
  font-size: 19rpx;
  line-height: 1.45;
}
