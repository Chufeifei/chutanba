/* 08 我的·个人中心：色值一律走 app.wxss 变量，圆角一律 var(--radius-*) */
.profile-head { display: flex; align-items: center; gap: 24rpx; margin: 8rpx 0 24rpx; }
.avatar { width: 128rpx; height: 128rpx; border-radius: var(--radius-pill); background: var(--color-brand-soft); flex: none; }
.head-info { display: flex; flex-direction: column; gap: 12rpx; }
.nickname { font-size: 36rpx; font-weight: 500; color: var(--color-text); }

.switch-card { display: flex; align-items: center; justify-content: space-between; min-height: 128rpx; }
.switch-left { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.switch-title { font-size: 26rpx; color: var(--color-text-muted); }
.switch-sub { font-size: 30rpx; color: var(--color-text); }
.switch-btn { width: 212rpx; height: 80rpx; border-radius: var(--radius-card); background: var(--color-brand-soft); color: var(--color-brand); display: flex; align-items: center; justify-content: center; font-size: 28rpx; flex: none; position: relative; }
/* 透明扩展热区：视觉 80rpx 高不变，实际可点区域 ≥88rpx */
.switch-btn::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  min-width: 88rpx;
  height: 100%;
  min-height: 88rpx;
  transform: translate(-50%, -50%);
}

.stat-grid { display: flex; justify-content: space-between; gap: 16rpx; margin: 16rpx 0; }
.stat-grid .card + .card { margin-top: 0; }
.stat-card { width: 330rpx; height: 160rpx; display: flex; flex-direction: column; justify-content: center; gap: 8rpx; }
.stat-value { font-size: 44rpx; font-weight: 600; color: var(--color-text); }
.stat-label { font-size: 24rpx; color: var(--color-text-muted); }

.status-line { margin: 12rpx 0; padding: 12rpx 24rpx; border-radius: var(--radius-card); background: var(--color-warning-soft); color: var(--color-warning); font-size: 24rpx; }

.entry-list { padding: 0; }
.entry-row { display: flex; align-items: center; justify-content: space-between; height: 112rpx; padding: 0 var(--space-card); border-bottom: 1rpx solid var(--color-border); }
.entry-row:last-child { border-bottom: 0; }
.entry-label { font-size: 30rpx; color: var(--color-text); }
.entry-arrow { font-size: 34rpx; color: var(--color-text-hint); }

.governance-entry { display: flex; align-items: center; justify-content: space-between; height: 112rpx; }
