.limit-row {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: 26rpx;
}
.entry-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.entry-row:last-child { border-bottom: 0; }
.entry-main { flex: 1; min-width: 0; }
.entry-text { color: var(--color-text); font-size: 30rpx; }
.entry-hint { margin-top: 8rpx; color: var(--color-text-muted); font-size: 24rpx; line-height: 34rpx; }
.entry-arrow { color: var(--color-text-hint); font-size: 34rpx; }
