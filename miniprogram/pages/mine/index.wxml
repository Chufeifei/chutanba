<view class="page-shell with-tab-bar">
  <!-- 一级个人中心：头像 / 昵称 / 身份胶囊 -->
  <view class="profile-head">
    <view class="avatar"></view>
    <view class="head-info">
      <text class="nickname">我的</text>
      <view class="chip {{identified ? 'active' : ''}}">{{identified ? '已识别' : '未识别'}}</view>
    </view>
  </view>

  <!-- 身份切换卡：左两行状态 + 右切换入口 -->
  <view class="card switch-card">
    <view class="switch-left">
      <text class="switch-title">当前身份</text>
      <text class="switch-sub">{{profileStateLabel}}</text>
    </view>
    <view class="switch-btn" bindtap="onSwitchTap">切换 ›</view>
  </view>

  <!-- 两枚数据小卡：字段名保留 -->
  <view class="stat-grid">
    <view class="card stat-card">
      <text class="stat-value">{{statOpenDays}}</text>
      <text class="stat-label">累计出摊</text>
    </view>
    <view class="card stat-card">
      <text class="stat-value">{{statFeedbackCount}}</text>
      <text class="stat-label">我的反馈</text>
    </view>
  </view>

  <!-- 状态行：只写状态，不写规则解释 -->
  <view class="status-line" wx:if="{{!identified}}">账号暂不可识别</view>
  <view class="status-line" wx:if="{{selfStopped}}">本人已停止公开</view>
  <view class="status-line" wx:if="{{governancePaused}}">当前处于治理暂停</view>

  <!-- 合并白卡入口列表：4 行 × 56 高 + 分割线，删行内小字 -->
  <view class="card entry-list" wx:if="{{entries.length}}">
    <view
      wx:for="{{entries}}"
      wx:key="key"
      class="entry-row"
      data-key="{{item.key}}"
      bindtap="onEntryTap"
    >
      <text class="entry-label">{{item.key === 'publication' ? '资料与处理记录' : item.text}}</text>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <!-- 底部治理入口：仅服务端下发管理能力时可见 -->
  <view class="card governance-entry" wx:if="{{showGovernance}}" data-key="management" bindtap="onEntryTap">
    <text class="entry-label">管理入口</text>
    <text class="entry-arrow">›</text>
  </view>

  <state-view
    wx:if="{{!identified}}"
    type="{{unidentifiedState.type}}"
    title="{{unidentifiedState.title}}"
    description="{{unidentifiedState.description}}"
  />
</view>
