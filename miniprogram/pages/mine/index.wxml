<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载个人中心…</view>

  <block wx:elif="{{me}}">
    <view class="profile card" bindtap="goVendor">
      <view class="avatar">
        <image wx:if="{{me.vendor && me.vendor.avatarUrl}}" src="{{me.vendor.avatarUrl}}" mode="aspectFill" />
        <image wx:else src="/assets/icons/vendor.png" mode="aspectFit" />
      </view>
      <view class="profile-main">
        <view class="profile-pill">MY STALL</view>
        <text class="profile-name">{{me.vendor ? me.vendor.name : '还没有摊主名片'}}</text>
        <text class="profile-desc">{{me.vendor ? (me.vendor.intro || '点击完善摊主介绍') : '完善一次资料，发布出摊自动带入'}}</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="stats">
      <view class="stat card" bindtap="goMyStalls">
        <image src="/assets/icons/nav-publish.png" mode="aspectFit" />
        <view>
          <text class="stat-number coral">{{me.stats.stalls}}</text>
          <text class="stat-label">我的发布</text>
        </view>
      </view>
      <view class="stat card mint" bindtap="goFavorites">
        <image src="/assets/icons/follow.png" mode="aspectFit" />
        <view>
          <text class="stat-number green">{{me.stats.favorites}}</text>
          <text class="stat-label">我的关注</text>
        </view>
      </view>
    </view>

    <view class="menu card">
      <view class="menu-item" bindtap="goMyStalls">
        <view class="menu-left"><view class="menu-icon-box"><image src="/assets/icons/nav-publish.png" mode="aspectFit" /></view><text>我的出摊</text></view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goVendor">
        <view class="menu-left"><view class="menu-icon-box"><image src="/assets/icons/edit.png" mode="aspectFit" /></view><text>摊主资料与自动填写</text></view>
        <text class="arrow">›</text>
      </view>
      <view wx:if="{{me.isAdmin}}" class="menu-item" bindtap="goAdmin">
        <view class="menu-left"><view class="menu-icon-box mint"><image src="/assets/icons/shield.png" mode="aspectFit" /></view><text>{{me.isSuperAdmin ? '超级管理面板' : '运营管理面板'}}</text></view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="menu card">
      <view class="menu-item" data-type="agreement" bindtap="goLegal">
        <view class="menu-left"><view class="menu-icon-box"><image src="/assets/icons/notice.png" mode="aspectFit" /></view><text>用户服务协议</text></view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" data-type="privacy" bindtap="goLegal">
        <view class="menu-left"><view class="menu-icon-box mint"><image src="/assets/icons/shield.png" mode="aspectFit" /></view><text>隐私政策</text></view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" data-type="rules" bindtap="goLegal">
        <view class="menu-left"><view class="menu-icon-box"><image src="/assets/icons/edit.png" mode="aspectFit" /></view><text>内容发布规范</text></view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" data-type="safety" bindtap="goLegal">
        <view class="menu-left"><view class="menu-icon-box mint"><image src="/assets/icons/category-fruit.png" mode="aspectFit" /></view><text>食品安全提示</text></view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="feedback">
        <view class="menu-left"><view class="menu-icon-box"><image src="/assets/icons/notice.png" mode="aspectFit" /></view><text>意见反馈</text></view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="about">
        <view class="menu-left"><view class="menu-icon-box mint"><image src="/assets/icons/store.png" mode="aspectFit" /></view><text>关于出摊吧</text></view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="developer card" bindtap="copyOpenid">
      <image src="/assets/icons/shield.png" mode="aspectFit" />
      <view class="developer-copy">
        <view class="identity-title-row">
          <text class="developer-label">真实身份编号（点击复制）</text>
          <text wx:if="{{me.isSuperAdmin}}" class="identity-role super">超级管理员</text>
          <text wx:elif="{{me.isAdmin}}" class="identity-role">管理员</text>
        </view>
        <text class="developer-value">{{me.openid}}</text>
        <text wx:if="{{!me.cloudIdentity}}" class="identity-warning">当前为本地预览身份，部署云函数后会显示真实 OpenID</text>
      </view>
    </view>

    <text class="version">出摊吧 · 管理与提醒优化版 1.2.0</text>
  </block>
</view>
