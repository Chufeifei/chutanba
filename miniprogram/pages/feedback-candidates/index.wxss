/* 顶部 Tab：双页签 + 3rpx 下划线 */
.tab-bar { display: flex; align-items: flex-end; height: 88rpx; margin-bottom: 24rpx; border-bottom: 1rpx solid var(--color-border); }
.tab-item { position: relative; height: 88rpx; padding: 0 8rpx; display: flex; align-items: center; font-size: 30rpx; color: var(--color-text-muted); }
.tab-item + .tab-item { margin-left: 48rpx; }
.tab-item.active { color: var(--color-brand); font-weight: 600; }
.tab-underline { position: absolute; left: 0; right: 0; bottom: 0; height: 3rpx; border-radius: 0; background: var(--color-brand); }

/* 连续记录列表：统一行高 152rpx、32rpx 圆角、32rpx padding（.card 提供） */
.record-row { height: 152rpx; margin-top: 16rpx; display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; }
.record-name { flex: 1; margin-right: 16rpx; font-size: 30rpx; font-weight: 500; color: var(--color-text); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.record-tag { font-size: 24rpx; color: var(--color-brand); }
.record-meta { margin-top: 8rpx; font-size: 26rpx; color: var(--color-text-muted); }
.list-end { margin-top: 32rpx; font-size: 24rpx; text-align: center; color: var(--color-text-hint); }
