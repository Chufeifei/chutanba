<view class="page-shell">
  <state-view
    wx:if="{{!showContent}}"
    type="{{viewState.type}}"
    title="{{viewState.title}}"
    description="{{viewState.description}}"
    action-text="{{viewState.actionText}}"
    bind:action="onStateAction"
  />

  <block wx:if="{{showContent}}">
    <!-- 顶部 Tab：双页签 + 3rpx 下划线 -->
    <view class="tab-bar">
      <view class="tab-item active">
        <text>待反馈</text>
        <view class="tab-underline"></view>
      </view>
      <view class="tab-item"><text>已提交</text></view>
    </view>

    <!-- 一张连续记录列表 -->
    <view class="record-list">
      <!-- 首行：待反馈入口，作为列表第 1 项白卡 -->
      <block wx:for="{{candidates}}" wx:key="observationId">
        <view
          class="card record-row"
          wx:if="{{index === 0}}"
          data-id="{{item.observationId}}"
          bindtap="onCandidateTap"
        >
          <view class="row-between">
            <text class="record-name">{{item.vendorName}}</text>
            <text class="record-tag">待反馈</text>
          </view>
          <text class="record-meta">{{item.eventText}}</text>
        </view>
      </block>

      <!-- 其余：已提交记录 -->
      <view
        class="card record-row"
        wx:for="{{records}}"
        wx:key="feedbackFactId"
        data-id="{{item.feedbackFactId}}"
        bindtap="onRecordTap"
      >
        <view class="row-between">
          <text class="record-name">{{item.vendorName}} · {{item.typeLabel}}</text>
          <status-dot tone="{{item.statusTone}}" text="{{item.statusLabel}}" />
        </view>
        <text class="record-meta">{{item.submittedText}}</text>
      </view>

      <view class="list-end">没有更多了</view>
    </view>
  </block>
</view>
