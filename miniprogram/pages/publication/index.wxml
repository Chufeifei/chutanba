<view class="page-shell">
  <state-view
    wx:if="{{!showContent}}"
    type="{{viewState.type}}"
    title="{{viewState.title}}"
    description="{{viewState.description}}"
    action-text="{{viewState.actionText}}"
    bind:action="onStateAction"
  />

  <block wx:if="{{showContent}}">
    <view class="card">
      <view class="row-between">
        <text class="section-title">资料状态</text>
        <text class="chip">{{model.profile.stateLabel}}</text>
      </view>
      <view class="text-link" bindtap="onProfileTap">{{model.profile.needsProfile ? '去补齐摊主资料' : '查看摊主资料'}} ›</view>
    </view>

    <!-- 停止公开状态卡 + 恢复公开操作合并成一张白卡 -->
    <view class="card">
      <text class="section-title">本人公开选择</text>
      <view class="state-line">{{model.self.statusText}}</view>
      <view class="state-line" wx:if="{{model.self.stopped}}">停止于 {{model.self.stoppedText}}</view>
      <button class="inline-btn" wx:if="{{model.self.canStop}}" disabled="{{submitPending}}" bindtap="onStopTap">停止公开</button>
      <button class="inline-btn" wx:if="{{model.self.canResume}}" disabled="{{submitPending}}" bindtap="onResumeTap">恢复公开</button>
      <button class="inline-btn" wx:if="{{!model.self.canStop && !model.self.canResume}}" disabled>暂不可恢复公开</button>
    </view>

    <view class="card">
      <text class="section-title">治理限制</text>
      <view class="state-line">{{model.governance.statusText}}</view>
      <view class="state-line" wx:if="{{model.governance.paused}}">暂停于 {{model.governance.pausedText}}</view>
    </view>

    <!-- 资料处理：清除降为卡内文字链，本人处理记录为连续列表入口 -->
    <view class="card">
      <text class="section-title">资料处理</text>
      <view class="text-link" bindtap="onClearTap">资料清除 ›</view>
      <view class="text-link" bindtap="onRecordsTap">本人处理记录 ›</view>
    </view>

    <view class="submit-message" wx:if="{{submitMessage}}">{{submitMessage}}</view>
    <button class="query-button" wx:if="{{unknownVisible}}" bindtap="onQueryOutcome">查看最新结果</button>
  </block>

  <confirm-sheet
    visible="{{confirmVisible}}"
    title="{{confirmSheet.title}}"
    description="{{confirmSheet.description}}"
    confirm-text="{{confirmSheet.confirmText}}"
    processing="{{submitPending}}"
    bind:confirm="onConfirmSubmit"
    bind:cancel="onConfirmCancel"
  />
</view>
