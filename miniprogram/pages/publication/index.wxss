/* 13 公开与资料处理：色值一律走 app.wxss 变量，卡片圆角统一 var(--radius-card) */
.state-line { margin-top: 12rpx; font-size: 28rpx; line-height: 42rpx; color: var(--color-text-muted); }

.text-link { margin-top: 16rpx; color: var(--color-brand); font-size: 28rpx; }
.inline-btn { margin-top: 20rpx; width: 100%; height: 88rpx; border-radius: var(--radius-card); background: var(--color-brand); color: var(--color-surface); font-size: 28rpx; line-height: 88rpx; }
.inline-btn[disabled] { background: var(--color-neutral-soft); color: var(--color-text-hint); }

.submit-message { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: var(--radius-card); background: var(--color-warning-soft); font-size: 26rpx; line-height: 38rpx; color: var(--color-warning); }
.query-button { margin-top: 16rpx; width: 100%; height: 88rpx; border-radius: var(--radius-card); background: var(--color-brand-soft); color: var(--color-brand); font-size: 28rpx; line-height: 88rpx; }
