/* 页头：大标题 56rpx + 副标题 26rpx + 定位/结果数行 + 紧凑横向 chip 条 */
.page-head { margin-bottom: 24rpx; }
.page-title { font-size: 56rpx; line-height: 76rpx; font-weight: 600; color: var(--color-text); }
.page-subtitle { margin-top: 8rpx; font-size: 26rpx; line-height: 38rpx; color: var(--color-text-muted); }
.page-location { margin-top: 12rpx; font-size: 24rpx; line-height: 34rpx; color: var(--color-text-muted); }
.header-picker { display: block; margin: 16rpx -32rpx 0; }

/* 17 定位拒绝：343×36 一行提示条 */
.location-bar { display: flex; align-items: center; justify-content: space-between; height: 72rpx; margin-bottom: 16rpx; padding: 0 24rpx; border-radius: 24rpx; background: var(--color-warning-soft); box-sizing: border-box; }
.location-bar-text { font-size: 24rpx; color: var(--color-warning); }
.location-bar-action { margin: 0; padding: 0 16rpx; height: 48rpx; line-height: 48rpx; font-size: 24rpx; color: var(--color-brand); background: transparent; border-radius: 24rpx; }

/* 局部同步态 */
.notice-bar { margin-bottom: 24rpx; padding: 20rpx 24rpx; border-radius: 24rpx; background: var(--color-neutral-soft); font-size: 26rpx; line-height: 38rpx; color: var(--color-text-muted); }
.notice-bar.warn { background: var(--color-warning-soft); color: var(--color-warning); }

/* 03 / 18 白卡：686×400rpx */
.state-hero { display: block; height: auto; min-height: 400rpx; margin: 0; padding: 0; border-radius: var(--radius-card); background: var(--color-surface); box-sizing: border-box; }

/* 01 列表：组件外层类覆盖，保证卡片间距与圆角 */
.vendor-list { display: block; }
.vendor-card-slot { display: block; border-radius: var(--radius-card); overflow: hidden; }
.vendor-card-slot + .vendor-card-slot { margin-top: var(--space-gap); }
.map-entry { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 88rpx; margin-top: 24rpx; padding: 16rpx 24rpx; border-radius: 44rpx; background: var(--color-brand-soft); color: var(--color-brand); box-sizing: border-box; }
.map-entry-main { display: flex; align-items: center; font-size: 30rpx; }
.map-entry-arrow { margin-left: 8rpx; font-size: 36rpx; }
.map-entry-sub { margin-top: 4rpx; font-size: 24rpx; color: var(--color-text-muted); }

/* 02 地图：主体 1096rpx，浮层卡 192rpx */
.vendor-map { width: 100%; height: 1096rpx; border-radius: var(--radius-card); overflow: hidden; }
.map-card { min-height: 192rpx; margin-top: 24rpx; padding: 8rpx; border-radius: var(--radius-card); background: var(--color-brand-soft); box-sizing: border-box; }
