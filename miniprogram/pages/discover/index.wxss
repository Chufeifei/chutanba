.notice-bar { margin-bottom: 24rpx; padding: 20rpx 24rpx; border-radius: 24rpx; background: var(--color-neutral-soft); font-size: 26rpx; line-height: 38rpx; color: var(--color-text-muted); }
.notice-bar.warn { background: var(--color-warning-soft); color: var(--color-warning); }

.mode-switch { display: flex; margin-bottom: 24rpx; padding: 6rpx; border-radius: 32rpx; background: var(--color-surface); }
.mode-item { flex: 1; height: 64rpx; border-radius: 28rpx; font-size: 26rpx; line-height: 64rpx; text-align: center; color: var(--color-text-muted); }
.mode-item.is-active { background: var(--color-brand-soft); color: var(--color-brand); font-weight: 500; }

.vendor-map { width: 100%; height: 760rpx; border-radius: var(--radius-card); overflow: hidden; }

.map-card { margin-top: 24rpx; padding: 8rpx; border-radius: var(--radius-card); background: var(--color-brand-soft); }
