<view class="page-shell with-tab-bar">
  <category-picker
    items="{{categoryItems}}"
    activeCode="{{activeCategoryCode}}"
    bind:change="onCategoryChange"
  />

  <view class="notice-bar warn" wx:if="{{syncStale}}">
    状态未更新，暂时无法确认是否仍在营业；请重新确认后再前往
  </view>
  <view class="notice-bar" wx:if="{{locationHint}}">{{locationHint}}</view>

  <state-view
    wx:if="{{!hasContent}}"
    type="{{viewState.type}}"
    title="{{viewState.title}}"
    description="{{viewState.description}}"
    action-text="{{viewState.actionText}}"
    bind:action="onStateAction"
  />

  <block wx:if="{{hasContent}}">
    <view class="mode-switch">
      <view class="mode-item {{viewMode === 'list' ? 'is-active' : ''}}" data-mode="list" bindtap="onViewModeChange">列表</view>
      <view class="mode-item {{viewMode === 'map' ? 'is-active' : ''}}" data-mode="map" bindtap="onViewModeChange">地图</view>
    </view>

    <block wx:if="{{viewMode === 'list'}}">
      <vendor-card
        wx:for="{{vendors}}"
        wx:key="vendorId"
        vendor="{{item}}"
        bind:select="onVendorTap"
      />
    </block>

    <block wx:else>
      <map
        class="vendor-map"
        latitude="{{mapLatitude}}"
        longitude="{{mapLongitude}}"
        markers="{{markers}}"
        scale="14"
        show-location="{{canShowLocation}}"
        bindmarkertap="onMarkerTap"
      />
      <view class="map-card" wx:if="{{activeVendor}}">
        <vendor-card vendor="{{activeVendor}}" compact bind:select="onVendorTap" />
      </view>
    </block>
  </block>
</view>
