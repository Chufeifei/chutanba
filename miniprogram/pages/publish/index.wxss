.publish-hero {
  position: relative;
  min-height: 238rpx;
  overflow: hidden;
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  background: linear-gradient(135deg, #fff0e5, #f0faf5);
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 520rpx;
}

.brand-pill {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #ef6d56;
  font-size: 20rpx;
  font-weight: 850;
  letter-spacing: 1rpx;
}

.publish-title,
.publish-desc {
  display: block;
}

.publish-title {
  margin-top: 14rpx;
  font-size: 38rpx;
  font-weight: 900;
}

.publish-desc {
  margin-top: 10rpx;
  color: #80675f;
  font-size: 24rpx;
  line-height: 1.55;
}

.hero-icon-card {
  width: 126rpx;
  height: 126rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  border-radius: 34rpx;
  background: rgba(255,255,255,.82);
  box-shadow: 0 12rpx 28rpx rgba(88,59,49,.07);
}

.hero-icon-card image {
  width: 86rpx;
  height: 86rpx;
}

.vendor-tip,
.vendor-ready {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
  padding: 24rpx;
}

.vendor-card-icon,
.vendor-avatar {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-right: 18rpx;
  border-radius: 24rpx;
  background: #fff0e7;
}

.vendor-card-icon image,
.vendor-avatar image {
  width: 62rpx;
  height: 62rpx;
}

.vendor-avatar image[mode="aspectFill"] {
  width: 100%;
  height: 100%;
}

.vendor-copy,
.vendor-info {
  flex: 1;
  min-width: 0;
}

.vendor-title,
.vendor-name {
  display: block;
  font-size: 29rpx;
  font-weight: 850;
}

.vendor-sub {
  display: block;
  max-width: 500rpx;
  margin-top: 7rpx;
  overflow: hidden;
  color: #8f746c;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.prefill-btn {
  width: 228rpx;
  height: 66rpx;
  min-height: 66rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  padding: 0 16rpx;
  border: 1rpx solid #f0cabc;
  border-radius: 999rpx;
  background: #fff5ef;
  color: #ec6a53;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1;
  text-align: center;
}

.form-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.form-section-title {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #f4e1d9;
}

.form-section-title image {
  width: 58rpx;
  height: 58rpx;
  margin-right: 14rpx;
}

.form-section-main,
.form-section-sub {
  display: block;
}

.form-section-main {
  font-size: 30rpx;
  font-weight: 850;
}

.form-section-sub {
  margin-top: 4rpx;
  color: #957a71;
  font-size: 21rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -12rpx;
  margin-bottom: -12rpx;
}

.category-option {
  width: calc(25% - 12rpx);
  min-height: 126rpx;
  margin: 0 12rpx 12rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 6rpx;
  border: 1rpx solid #f0d4c9;
  border-radius: 22rpx;
  background: #fffaf7;
  color: #755d55;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.category-option.active {
  border-color: #ff9b82;
  background: #fff0e8;
  color: #e96850;
  box-shadow: inset 0 0 0 1rpx #ffc0af;
}

.category-option-icon {
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 6rpx;
}

.category-option-icon image {
  width: 100%;
  height: 100%;
}

.custom-category {
  margin-top: 16rpx;
}

.time-row {
  display: flex;
  gap: 18rpx;
}

.time-item {
  flex: 1;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #a78a80;
}

.place-btn {
  width: 100%;
  min-height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border: 1rpx dashed #edbca9;
  border-radius: 22rpx;
  background: #fff8f4;
  color: #6c514a;
  font-size: 27rpx;
}

.place-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.place-main image {
  width: 42rpx;
  height: 42rpx;
  margin-right: 10rpx;
}

.place-text {
  max-width: 520rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-arrow {
  color: #ad9187;
  font-size: 42rpx;
}

.privacy-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
}

.privacy-title {
  display: block;
  font-size: 25rpx;
  font-weight: 750;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item,
.add-image {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  overflow: hidden;
  border-radius: 22rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(51, 37, 32, 0.75);
  color: #fff;
  font-size: 30rpx;
}

.add-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #e7bba9;
  background: #fff8f4;
  color: #9a776c;
  font-size: 23rpx;
}

.add-image image {
  width: 62rpx;
  height: 62rpx;
  margin-bottom: 8rpx;
}

.textarea.small {
  min-height: 130rpx;
}

.submit {
  margin-top: 28rpx;
}

.submit[disabled],
.submit.submitted {
  opacity: 0.78;
}

.publish-success-tip {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #2f8f73;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
  background: #edf9f4;
  border: 1rpx solid #bfe8d8;
  border-radius: 22rpx;
}

.success-mark {
  width: 34rpx;
  height: 34rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 34rpx;
  background: #45b38c;
  border-radius: 50%;
}
