.detail-page {
  min-height: 100vh;
  padding: 0 22rpx calc(150rpx + env(safe-area-inset-bottom));
  background: #fff8f2;
}

.cover {
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin: 0 -22rpx;
  background: linear-gradient(145deg, #ffe0d3, #fff3ea);
}

.cover.mint {
  background: linear-gradient(145deg, #daf5e8, #f4fff9);
}

.cover.orange {
  background: linear-gradient(145deg, #ffe0b6, #fff5e6);
}

.cover image {
  width: 100%;
  height: 100%;
}

.cover-icon-card {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,.9);
  border-radius: 46rpx;
  background: rgba(255,255,255,.76);
  box-shadow: 0 14rpx 32rpx rgba(84,57,47,.07);
}

.cover-icon-card image {
  width: 112rpx;
  height: 112rpx;
}

.cover-status {
  position: absolute;
  top: 28rpx;
  left: 26rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(73, 50, 44, 0.82);
  color: #fff;
  font-size: 23rpx;
  font-weight: 800;
}

.cover-status.open {
  background: #39a886;
}

.main-card {
  position: relative;
  z-index: 2;
  margin-top: -52rpx;
  padding: 30rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.title,
.vendor {
  display: block;
}

.title {
  font-size: 40rpx;
  font-weight: 900;
}

.vendor {
  margin-top: 8rpx;
  color: #8c7168;
  font-size: 24rpx;
}

.favorite {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #f0d5ca;
  border-radius: 50%;
  background: #fff7f2;
}

.favorite image {
  width: 48rpx;
  height: 48rpx;
  opacity: .68;
}

.favorite.active {
  background: #ffe9df;
  border-color: #ffad99;
}

.favorite.active image {
  opacity: 1;
}

.tags {
  margin-top: 20rpx;
}

.info-block {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f3dfd7;
}

.info-icon {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border-radius: 22rpx;
}

.info-icon image {
  width: 48rpx;
  height: 48rpx;
}

.info-icon.coral {
  background: #fff0e8;
}

.info-icon.mint {
  background: #e8f7ef;
}

.info-main {
  flex: 1;
  min-width: 0;
}

.info-title,
.info-value,
.info-extra {
  display: block;
}

.info-title {
  color: #8c7168;
  font-size: 22rpx;
}

.info-value {
  margin-top: 5rpx;
  font-weight: 750;
}

.info-extra {
  margin-top: 6rpx;
  color: #39a886;
  font-size: 21rpx;
}

.text-btn {
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: #fff0e8;
  color: #ef674f;
  font-size: 23rpx;
  font-weight: 750;
}

.notice,
.content-card,
.safe {
  margin-top: 20rpx;
  padding: 28rpx;
}

.notice {
  display: flex;
  align-items: flex-start;
  background: #fff2e8;
}

.notice > image {
  width: 54rpx;
  height: 54rpx;
  margin-right: 14rpx;
}

.notice-label,
.notice-text,
.content-title,
.description,
.menu-label,
.menu-value,
.safe-title,
.safe-copy {
  display: block;
}

.notice-label {
  color: #ee6d55;
  font-size: 22rpx;
  font-weight: 850;
}

.notice-text {
  margin-top: 9rpx;
  line-height: 1.65;
}

.content-head {
  display: flex;
  align-items: center;
}

.content-head image {
  width: 54rpx;
  height: 54rpx;
  margin-right: 12rpx;
}

.content-title,
.safe-title {
  font-size: 31rpx;
  font-weight: 850;
}

.description,
.safe-copy {
  margin-top: 14rpx;
  color: #6f5650;
  line-height: 1.75;
}

.menu-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff8f4;
}

.menu-label {
  color: #9d7669;
  font-size: 21rpx;
}

.menu-value {
  margin-top: 6rpx;
  font-weight: 700;
}

.photo-scroll {
  margin: 20rpx 0;
  white-space: nowrap;
}

.photo-row {
  display: inline-flex;
}

.photo {
  width: 260rpx;
  height: 210rpx;
  margin-right: 16rpx;
  border-radius: 22rpx;
}

.safe {
  display: flex;
  align-items: flex-start;
  background: #effaf5;
  border-color: #bfe6d6;
}

.safe > image {
  width: 58rpx;
  height: 58rpx;
  margin-right: 14rpx;
}

.safe-main {
  flex: 1;
}

.report {
  margin-top: 20rpx;
  color: #9b7164;
  font-size: 23rpx;
  text-decoration: underline;
}

.bottom-actions {
  position: fixed;
  z-index: 30;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f1d8cd;
  background: rgba(255, 253, 251, 0.97);
}

.action-secondary,
.action-primary {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-weight: 800;
}

.action-secondary {
  width: 220rpx;
  background: #fff1e9;
  color: #ef674f;
}

.action-primary {
  flex: 1;
  background: #ff7561;
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(255, 117, 97, 0.22);
}
