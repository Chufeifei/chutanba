.legal-hero {
  padding: 34rpx;
  text-align: center;
  background: linear-gradient(135deg, #fff0e6, #effaf5);
}

.legal-icon,
.legal-title,
.legal-date {
  display: block;
}

.legal-icon {
  width: 78rpx;
  height: 78rpx;
  margin: 0 auto;
}

.legal-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 900;
}

.legal-date {
  margin-top: 8rpx;
  color: #8e746c;
  font-size: 22rpx;
}

.legal-card {
  margin-top: 20rpx;
  padding: 30rpx;
}

.legal-section {
  margin-bottom: 34rpx;
}

.legal-section:last-child {
  margin-bottom: 0;
}

.heading,
.body {
  display: block;
}

.heading {
  font-size: 29rpx;
  font-weight: 850;
}

.body {
  margin-top: 12rpx;
  color: #6f5750;
  line-height: 1.85;
  text-align: justify;
}
