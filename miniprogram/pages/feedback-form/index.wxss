/* 顶部 Tab：双页签 + 3rpx 下划线 */
.tab-bar { display: flex; align-items: flex-end; height: 88rpx; margin-bottom: 24rpx; border-bottom: 1rpx solid var(--color-border); }
.tab-item { position: relative; height: 88rpx; padding: 0 8rpx; display: flex; align-items: center; font-size: 30rpx; color: var(--color-text-muted); }
.tab-item + .tab-item { margin-left: 48rpx; }
.tab-item.active { color: var(--color-brand); font-weight: 600; }
.tab-underline { position: absolute; left: 0; right: 0; bottom: 0; height: 3rpx; border-radius: var(--radius-chip); background: var(--color-brand); }

/* 反馈对象卡：蜜色，单行 */
.object-card { min-height: 96rpx; padding: 24rpx var(--space-card); display: flex; align-items: center; background: var(--color-warning-soft); }
.field-label { font-size: 28rpx; color: var(--color-text); }
.field-value { font-size: 26rpx; color: var(--color-text-muted); }
.object-value { flex: 1; margin-left: 24rpx; font-size: 26rpx; text-align: right; color: var(--color-text-muted); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 4 枚胶囊：一行均分，父容器 padding 6rpx，文字不出框 */
.chip-group { display: flex; gap: 12rpx; margin-top: 24rpx; }
.chip-cell { flex: 1; min-width: 0; position: relative; padding: 6rpx; }
.chip-native { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; }
.chip-cell .chip { display: flex; align-items: center; justify-content: center; width: 100%; height: 64rpx; padding: 0 6rpx; border-radius: var(--radius-chip); text-align: center; overflow: hidden; white-space: nowrap; font-size: 24rpx; box-sizing: border-box; }
.chip-cell .chip.active { background: var(--color-brand); color: var(--color-surface); }
.chip-cell .chip text { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.chip-cell .chip.is-disabled { opacity: 0.5; }

/* 位置证据卡（含重新定位小按钮） / 定位失败蜜色色块 */
.location-card { min-height: 96rpx; margin-top: 24rpx; padding: 24rpx var(--space-card); display: flex; align-items: center; }
.location-right { display: flex; align-items: center; gap: 16rpx; }
.relocate-mini { padding: 8rpx 20rpx; border-radius: var(--radius-chip); border: 1rpx solid var(--color-brand); color: var(--color-brand); font-size: 24rpx; line-height: 32rpx; }
.location-fail { margin-top: 24rpx; }
.location-fail-block { width: 100%; height: 400rpx; border-radius: var(--radius-card); background: var(--color-warning-soft); }
.location-fail-tip { display: block; margin-top: 16rpx; font-size: 26rpx; line-height: 38rpx; text-align: center; color: var(--color-text-muted); }

/* 描述输入 */
.desc-input { width: 100%; height: 160rpx; margin-top: 24rpx; padding: 24rpx; border-radius: var(--radius-card); background: var(--color-surface); box-sizing: border-box; font-size: 28rpx; line-height: 44rpx; }

/* 条件提示 */
.submit-message { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: var(--radius-card); background: var(--color-warning-soft); font-size: 26rpx; line-height: 38rpx; color: var(--color-warning); }
.query-button { margin-top: 16rpx; height: 88rpx; border-radius: var(--radius-button); background: var(--color-brand); color: var(--color-surface); font-size: 28rpx; line-height: 88rpx; }
