.meta { margin-top: 12rpx; font-size: 28rpx; line-height: 42rpx; color: var(--color-text-muted); }
.hint { margin-top: 16rpx; font-size: 24rpx; line-height: 36rpx; color: var(--color-text-hint); }

.option { display: flex; align-items: flex-start; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-border); }
.option:last-child { border-bottom: 0; }
.option-body { flex: 1; margin-left: 12rpx; }
.option-label { font-size: 30rpx; color: var(--color-text); }
.option-desc { display: block; margin-top: 6rpx; font-size: 24rpx; line-height: 36rpx; color: var(--color-text-muted); }
.option.is-disabled { opacity: 0.55; }

.desc-input { width: 100%; min-height: 200rpx; margin-top: 16rpx; padding: 20rpx; border-radius: 24rpx; background: var(--color-bg); box-sizing: border-box; font-size: 28rpx; line-height: 44rpx; }
.counter { margin-top: 8rpx; font-size: 22rpx; text-align: right; color: var(--color-text-hint); }

.submit-message { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: 24rpx; background: var(--color-warning-soft); font-size: 26rpx; line-height: 38rpx; color: var(--color-warning); }
.query-button { margin-top: 16rpx; height: 88rpx; border-radius: 44rpx; background: var(--color-brand); color: #FFFFFF; font-size: 28rpx; line-height: 88rpx; }
