.report-card {
  padding: 30rpx;
}

.report-title,
.report-sub {
  display: block;
}

.report-title {
  font-size: 38rpx;
  font-weight: 900;
}

.report-sub {
  margin-top: 10rpx;
  color: #876d65;
  font-size: 23rpx;
  line-height: 1.6;
}

.reasons {
  margin: 26rpx 0 30rpx;
  overflow: hidden;
  border: 1rpx solid #f2d8cd;
  border-radius: 24rpx;
}

.reason {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f3e1da;
  background: #fffaf7;
}

.reason:last-child {
  border-bottom: 0;
}

.reason.active {
  background: #fff0e8;
  color: #ed674f;
  font-weight: 750;
}

.radio {
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d8b5a8;
  border-radius: 50%;
  background: #fff;
}

.radio.active {
  border-color: #ff7561;
}

.radio-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: transparent;
}

.radio.active .radio-dot {
  background: #ff7561;
}
