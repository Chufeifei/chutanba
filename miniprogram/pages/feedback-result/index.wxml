<view class="page-shell {{showContent ? 'with-fixed-cta' : ''}}">
  <state-view
    wx:if="{{!showContent}}"
    type="{{viewState.type}}"
    title="{{viewState.title}}"
    description="{{viewState.description}}"
    action-text="{{viewState.actionText ? '返回详情' : ''}}"
    bind:action="onStateAction"
  />

  <block wx:if="{{showContent}}">
    <!-- 成功区：插画 + 主文案 + 副文案居中 -->
    <view class="success-hero">
      <view class="success-art" wx:if="{{fromSubmit}}"><view class="success-check"></view></view>
      <view class="success-art is-neutral" wx:else><text class="success-art-text">{{result.statusLabel}}</text></view>
      <text class="success-title">{{fromSubmit ? '反馈已提交' : result.title}}</text>
      <text class="success-desc">{{fromSubmit ? result.title : result.description}}</text>
    </view>

    <!-- 本次反馈资料白卡：状态 / 对象 / 时间 -->
    <view class="card detail-card">
      <text class="section-title">本次反馈</text>
      <view class="detail-line"><text class="detail-label">状态</text><text class="detail-value">{{result.statusLabel}}</text></view>
      <view class="detail-line" wx:if="{{result.vendorName}}"><text class="detail-label">反馈对象</text><text class="detail-value">{{result.vendorName}}</text></view>
      <view class="detail-line" wx:if="{{result.submittedText}}"><text class="detail-label">提交时间</text><text class="detail-value">{{result.submittedText}}</text></view>
    </view>
  </block>

  <fixed-cta
    wx:if="{{showContent}}"
    primary-text="查看我的反馈"
    secondary-text="返回详情"
    bind:primary="onOpenRecords"
    bind:secondary="onStateAction"
  />
</view>
