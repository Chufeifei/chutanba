/* 页面专属样式；通用样式与设计变量见 app.wxss */

.notice {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--color-warning-soft);
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--color-warning);
}

.meta { margin-top: 12rpx; font-size: 28rpx; line-height: 42rpx; color: var(--color-text-muted); }
.hint { margin-top: 12rpx; font-size: 24rpx; line-height: 36rpx; color: var(--color-text-hint); }

.item-row {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}
.item-head { display: flex; align-items: center; justify-content: space-between; }
.item-title { font-size: 28rpx; font-weight: 500; color: var(--color-text); }
.item-count { font-size: 24rpx; color: var(--color-text-hint); }

.form-block { margin-top: 20rpx; }
.field-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--color-bg);
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 44rpx;
}
.field-error { margin-top: 8rpx; font-size: 24rpx; line-height: 34rpx; color: var(--color-brand); }

.primary-button {
  margin-top: 20rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: var(--color-brand);
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 84rpx;
}
.primary-button[disabled] { background: var(--color-neutral-soft); color: var(--color-text-hint); }

.link-button {
  margin-top: 16rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  font-size: 26rpx;
  line-height: 76rpx;
}
.link-button[disabled] { background: var(--color-neutral-soft); color: var(--color-text-hint); }

.more-button {
  margin-top: 24rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--color-neutral-soft);
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 80rpx;
}

.submit-message {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--color-warning-soft);
  font-size: 26rpx;
  line-height: 38rpx;
  color: var(--color-warning);
}

.query-button {
  margin-top: 16rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-brand);
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 88rpx;
}
