/* 13 处理记录：色值一律走 app.wxss 变量，圆角统一 var(--radius-*) */
.notice { padding: 18rpx 20rpx; border-radius: var(--radius-card); background: var(--color-warning-soft); font-size: 24rpx; line-height: 36rpx; color: var(--color-warning); }

.meta { margin-top: 12rpx; font-size: 28rpx; line-height: 42rpx; color: var(--color-text-muted); }
.hint { margin-top: 12rpx; font-size: 24rpx; line-height: 36rpx; color: var(--color-text-hint); }

.item-row { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--color-border); }
.item-head { display: flex; align-items: center; justify-content: space-between; }
.item-title { font-size: 28rpx; font-weight: 500; color: var(--color-text); }
.item-count { font-size: 24rpx; color: var(--color-text-hint); }

.form-block { margin-top: 20rpx; }
.field-textarea { width: 100%; min-height: 160rpx; padding: 20rpx; border-radius: var(--radius-card); background: var(--color-bg); box-sizing: border-box; font-size: 28rpx; line-height: 44rpx; }
.field-error { margin-top: 8rpx; font-size: 24rpx; line-height: 34rpx; color: var(--color-brand); }

/* 按钮尺寸与外观一律走 app.wxss 语义类；此处只保留布局差异（margin） */
.primary-button { width: 100%; margin-top: 20rpx; }
.link-button { width: 100%; margin-top: 16rpx; }
.more-button { width: 100%; margin-top: 24rpx; }
.query-button { width: 100%; margin: 16rpx auto 0; }
.btn-primary[disabled] { background: var(--color-neutral-soft); color: var(--color-text-hint); }
.btn-secondary[disabled] { border-color: var(--color-border); background: var(--color-neutral-soft); color: var(--color-text-hint); }

.submit-message { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: var(--radius-card); background: var(--color-warning-soft); font-size: 26rpx; line-height: 38rpx; color: var(--color-warning); }

/* 空/错/成功态白卡：686×400rpx */
.state-hero { display: block; height: auto; min-height: 400rpx; margin: 0; padding: 0; border-radius: var(--radius-card); background: var(--color-surface); box-sizing: border-box; }
