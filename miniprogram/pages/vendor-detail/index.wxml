<view class="page-shell {{showContent ? 'with-fixed-cta' : ''}}">

  <block wx:if="{{!showContent}}">
    <!-- 20 不可查看 / 加载失败：状态白卡 + 短引导 + 失败态重试按钮 -->
    <state-view
      class="state-hero"
      type="{{viewState.type}}"
      title="{{viewState.type === 'loading' ? '正在加载' : (viewState.type === 'terminal-error' ? '当前不可查看' : '暂时没能加载')}}"
      description="{{viewState.type === 'loading' ? '请稍候' : (viewState.type === 'terminal-error' ? '换个摊位看看吧' : '请重新加载')}}"
      action-text="{{viewState.type === 'loading' || viewState.type === 'terminal-error' ? '' : '重新加载'}}"
      bind:action="onStateAction"
    />
    <navigator class="btn-primary bottom-cta" open-type="switchTab" url="/pages/discover/index">返回首页</navigator>
  </block>

  <block wx:elif="{{detail.isResting}}">
    <!-- 05 详情休息中：灰态视觉块 + 一张资料白卡 + 禁用按钮，无位置卡与导航入口 -->
    <view class="category-visual is-muted"></view>
    <view class="card profile-card">
      <view class="row-between">
        <text class="detail-name">{{detail.profile.name}}</text>
        <phase-badge label="休息中" tone="neutral" />
      </view>
      <view class="chip category-chip">{{detail.profile.categoryName}}</view>
      <view class="detail-row" wx:if="{{detail.profile.summary}}">{{detail.profile.summary}}</view>
      <view class="status-phrase">摊主休息中，稍后再来看看</view>
    </view>
    <view class="btn-primary bottom-cta is-disabled">导航不可用</view>
  </block>

  <block wx:elif="{{confirmVisible}}">
    <!-- 06 导航前复核：蜜色提示条 + 复核资料白卡 + 「仍要导航 / 暂不前往」 -->
    <view class="review-bar">摊主准备收摊</view>
    <view class="card review-card">
      <view class="review-title">本次复核</view>
      <view class="detail-row">导航目的地：{{detail.location ? detail.location.locationName : '—'}}</view>
      <view class="detail-row">复核结果：摊主准备收摊</view>
    </view>
    <fixed-cta
      primary-text="仍要导航"
      secondary-text="暂不前往"
      processing="{{navBusy}}"
      bind:primary="onConfirmContinue"
      bind:secondary="onConfirmCancel"
    />
  </block>

  <block wx:elif="{{navReviewFailure}}">
    <!-- 19 导航复核失败：蜜色提示条（短原因） + 复核资料白卡 + 「重新复核 / 返回详情」 -->
    <view class="review-bar is-lg">{{navReviewMessage || '复核未通过'}}</view>
    <view class="card review-card">
      <view class="review-title">本次复核</view>
      <view class="detail-row">导航目的地：{{detail.location ? detail.location.locationName : '—'}}</view>
      <view class="detail-row">复核结果：未通过</view>
    </view>
    <fixed-cta
      primary-text="重新复核"
      secondary-text="返回详情"
      processing="{{navBusy}}"
      bind:primary="onRetryReview"
      bind:secondary="onReviewBack"
    />
  </block>

  <block wx:else>
    <!-- 04 详情出摊中：品类视觉块 + 一张资料白卡 + 当前位置卡 + 单个导航前往主 CTA -->
    <view class="category-visual"></view>
    <view class="card profile-card">
      <view class="row-between">
        <text class="detail-name">{{detail.profile.name}}</text>
        <phase-badge label="{{detail.session.phaseLabel}}" tone="{{detail.session.phaseTone}}" />
      </view>
      <view class="chip category-chip">{{detail.profile.categoryName}}</view>
      <view class="detail-row time-row">
        <countdown text="{{detail.session.remainingText}}" tone="{{detail.session.preparedToClose ? 'warning' : 'neutral'}}" />
      </view>
      <view class="detail-row" wx:if="{{detail.session.plannedEndText}}">预计 {{detail.session.plannedEndText}} 收摊</view>
      <view class="detail-row" wx:if="{{detail.profile.summary}}">{{detail.profile.summary}}</view>
      <view class="feedback-link" bindtap="onFeedback">现场反馈 ›</view>
    </view>
    <view class="card location-card" wx:if="{{detail.location}}">
      <view class="location-map"></view>
      <view class="row-between location-line">
        <text>{{detail.location.locationName}}</text>
        <text>更新于 {{detail.location.locatedText}}</text>
      </view>
    </view>
    <fixed-cta
      primary-text="{{navBusy ? '正在确认最新状态…' : '导航前往'}}"
      disabled="{{syncStale}}"
      processing="{{navBusy || feedbackBusy}}"
      bind:primary="onNavigate"
      bind:secondary="onFeedback"
    />
  </block>

  <!-- 局部同步态：只保留状态短语 -->
  <view class="notice-bar warn" wx:if="{{syncStale && showContent}}">状态未更新</view>

  <!-- D01 遮罩收敛：confirm-sheet 保留组件引用但常关，06 改由页面内双 CTA 承载 -->
  <confirm-sheet
    visible="{{false}}"
    title="{{confirmSheet.title}}"
    description="{{confirmSheet.description}}"
    confirm-text="{{confirmSheet.confirmText}}"
    cancel-text="{{confirmSheet.cancelText}}"
    processing="{{navBusy}}"
    bind:confirm="onConfirmContinue"
    bind:cancel="onConfirmCancel"
  />
</view>
