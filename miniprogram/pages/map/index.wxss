.map-page {
  min-height: 100vh;
  padding: 20rpx 20rpx 190rpx;
  background: #fff8f2;
}

.map-card {
  position: relative;
  overflow: hidden;
  height: 760rpx;
}

.map {
  width: 100%;
  height: 100%;
}

.locate-fab {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ecd3c8;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  color: #ff7561;
  font-size: 42rpx;
  box-shadow: 0 8rpx 20rpx rgba(77, 49, 40, 0.12);
}

.map-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 4rpx 18rpx;
}

.map-title,
.map-sub {
  display: block;
}

.map-title {
  font-size: 32rpx;
  font-weight: 850;
}

.map-sub {
  margin-top: 7rpx;
  color: #8f746c;
  font-size: 22rpx;
}

.locate-fab image {
  width: 48rpx;
  height: 48rpx;
}

.empty-art {
  display: block;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
}
