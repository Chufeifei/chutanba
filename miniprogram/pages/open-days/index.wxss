/* 出摊记录：色值一律走 app.wxss 变量，卡片圆角统一 var(--radius-card) */
.stat-row { display: flex; align-items: baseline; }
.stat-value { font-size: 56rpx; font-weight: 600; color: var(--color-text); }
.stat-label { margin-left: 16rpx; font-size: 26rpx; color: var(--color-text-muted); }

.meta { margin-top: 12rpx; font-size: 28rpx; line-height: 42rpx; color: var(--color-text-muted); }
.hint { margin-top: 16rpx; font-size: 24rpx; line-height: 36rpx; color: var(--color-text-hint); }

.day-row { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--color-border); }
.day-head { display: flex; align-items: center; justify-content: space-between; }
.day-date { font-size: 30rpx; font-weight: 500; color: var(--color-text); }
.day-count { font-size: 24rpx; color: var(--color-text-hint); }

.more-button { margin-top: 24rpx; height: 80rpx; border-radius: var(--radius-card); background: var(--color-neutral-soft); color: var(--color-text); font-size: 26rpx; line-height: 80rpx; }
