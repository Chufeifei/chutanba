.workbench-head { display: flex; align-items: center; justify-content: space-between; }
.workbench-title { font-size: 32rpx; font-weight: 500; color: var(--color-text); }

.meta { margin-top: 12rpx; font-size: 28rpx; line-height: 42rpx; color: var(--color-text-muted); }
.hint { margin-top: 16rpx; font-size: 24rpx; line-height: 36rpx; color: var(--color-text-hint); }

.limit-row { margin-top: 12rpx; padding: 16rpx 20rpx; border-radius: 20rpx; background: var(--color-warning-soft); font-size: 26rpx; line-height: 38rpx; color: var(--color-warning); }

.field-input { width: 100%; margin-top: 12rpx; padding: 20rpx; border-radius: 24rpx; background: var(--color-bg); box-sizing: border-box; font-size: 28rpx; line-height: 44rpx; }
.picker-value { margin-top: 16rpx; padding: 20rpx; border-radius: 24rpx; background: var(--color-bg); font-size: 28rpx; line-height: 44rpx; color: var(--color-text); }

.submit-message { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: 24rpx; background: var(--color-warning-soft); font-size: 26rpx; line-height: 38rpx; color: var(--color-warning); }
.query-button { margin-top: 16rpx; height: 88rpx; border-radius: 44rpx; background: var(--color-brand); color: #FFFFFF; font-size: 28rpx; line-height: 88rpx; }

.link-button { margin-top: 20rpx; height: 76rpx; border-radius: 38rpx; background: var(--color-brand-soft); color: var(--color-brand); font-size: 26rpx; line-height: 76rpx; }
