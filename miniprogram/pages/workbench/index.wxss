/* 09/10/11 工作台：色值一律走 app.wxss 变量，卡片圆角统一 var(--radius-card) */
.stat-grid { display: flex; gap: 16rpx; margin: 16rpx 0; }
.stat-grid .card + .card { margin-top: 0; }

/* 状态大卡 343×120 */
.status-card { min-height: 240rpx; display: flex; align-items: center; justify-content: space-between; }
.status-left { display: flex; flex-direction: column; gap: 12rpx; min-width: 0; }
.status-head { display: flex; align-items: center; gap: 12rpx; }
.status-point { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--color-text-hint); flex: none; }
.status-point.on { background: var(--color-success); }
.status-name { font-size: 44rpx; font-weight: 600; color: var(--color-text); }
.status-sub { font-size: 26rpx; color: var(--color-text-muted); }
.status-tags { display: flex; align-items: center; gap: 16rpx; margin-top: 8rpx; }
.status-meta { font-size: 24rpx; color: var(--color-text-muted); }
.status-deco { flex: none; margin-left: 16rpx; }

/* 两枚数据小卡 165×80 */
.stat-card { flex: 1; min-height: 160rpx; display: flex; flex-direction: column; justify-content: center; gap: 8rpx; }
.stat-value { font-size: 40rpx; font-weight: 600; color: var(--color-text); }
.stat-label { font-size: 24rpx; color: var(--color-text-muted); }

/* 当前位置卡：1 行短卡 */
.location-card { display: flex; align-items: center; justify-content: space-between; }
.location-label { font-size: 26rpx; color: var(--color-text-muted); }
.location-value { font-size: 28rpx; color: var(--color-text); }

/* 出摊日记录文字链 */
.text-link { margin: 16rpx 0; color: var(--color-brand); font-size: 28rpx; }
.text-link.subtle { margin: 8rpx 0 0; text-align: center; color: var(--color-text-muted); font-size: 26rpx; }

/* 今日记录空态卡 */
.today-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; min-height: 160rpx; }
.empty-title { font-size: 28rpx; color: var(--color-text); }
.empty-sub { font-size: 24rpx; color: var(--color-text-muted); }

.block-title { font-size: 30rpx; font-weight: 500; color: var(--color-text); }
.state-line { margin-top: 12rpx; font-size: 26rpx; line-height: 38rpx; color: var(--color-text-muted); }

/* 10 确认态：时间选择 / 定位说明，规格对齐 */
.picker-value { margin-top: 16rpx; padding: 20rpx; border-radius: var(--radius-card); background: var(--color-bg); font-size: 28rpx; line-height: 44rpx; color: var(--color-text); }
.field-input { width: 100%; margin-top: 16rpx; padding: 20rpx; border-radius: var(--radius-card); background: var(--color-bg); box-sizing: border-box; font-size: 28rpx; line-height: 44rpx; }
.field-note { display: block; margin-top: 12rpx; font-size: 24rpx; color: var(--color-text-hint); }

.notice { margin-top: 16rpx; padding: 20rpx 24rpx; border-radius: var(--radius-card); background: var(--color-warning-soft); font-size: 26rpx; line-height: 38rpx; color: var(--color-warning); }
.query-button { margin-top: 16rpx; width: 100%; height: 88rpx; border-radius: var(--radius-card); background: var(--color-brand-soft); color: var(--color-brand); font-size: 28rpx; line-height: 88rpx; }

/* 底部 CTA 区：主 CTA 固定在最底部 */
.cta-bar { position: fixed; z-index: 900; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 24rpx var(--space-page) calc(24rpx + env(safe-area-inset-bottom)); background: var(--color-bg); box-sizing: border-box; }
.btn-primary[disabled] { background: var(--color-neutral-soft); color: var(--color-text-hint); }
.cta-bar button { margin: 0; }
.cta-bar .btn-secondary[disabled] { border-color: var(--color-border); color: var(--color-text-hint); }
/* 11 主+次双按钮叠加，底部留白需覆盖 app.wxss 的单按钮值 */
.page-shell.with-fixed-cta.with-dual-cta { padding-bottom: calc(280rpx + env(safe-area-inset-bottom)); }
