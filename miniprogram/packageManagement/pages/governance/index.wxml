<view class="page-shell has-cta">
  <!-- 返回栏由原生 navigationBar 提供，本页无 TabBar -->

  <!-- 加载中 -->
  <view wx:if="{{viewState === 'loading'}}" class="card">
    <text class="field-label">{{tip}}</text>
  </view>

  <!-- 失败态 -->
  <view wx:if="{{viewState === 'failed'}}" class="card">
    <text class="field-label">{{tip}}</text>
    <button class="btn-secondary cta-btn" hover-class="cta-hover" bindtap="onReloadTap">重试</button>
  </view>

  <!-- 空态 -->
  <view wx:if="{{viewState === 'empty'}}" class="card">
    <text class="field-label">{{tip}}</text>
    <button class="btn-secondary cta-btn" hover-class="cta-hover" bindtap="onReloadTap">重新加载</button>
  </view>

  <!-- 列表态：治理对象列表 + 选中对象详情 -->
  <block wx:if="{{viewState === 'content'}}">
    <view class="card">
      <text class="section-title">处理对象</text>
      <view class="vendor-row row-between"
            wx:for="{{vendors}}" wx:key="vendorId"
            data-vendor-id="{{item.vendorId}}" bindtap="onVendorTap">
        <text class="field-label">{{item.vendorName}}</text>
        <text class="chip {{item.paused ? 'active' : ''}}">{{item.statusText}}</text>
      </view>
    </view>

    <view class="state-desc" wx:if="{{tip}}">{{tip}}</view>

    <block wx:if="{{detail}}">
      <view class="card">
        <view class="row-between">
          <text class="field-label">治理状态</text>
          <text class="field-value">{{detail.statusText}}</text>
        </view>
        <view class="field-row row-between">
          <text class="field-label">处理对象</text>
          <text class="field-value">{{detail.vendorName}}</text>
        </view>
        <view class="field-row row-between">
          <text class="field-label">生效时间</text>
          <text class="field-value">{{detail.effectiveText}}</text>
        </view>
        <view class="field-row row-between">
          <text class="field-label">处理人</text>
          <text class="field-value">{{detail.actorText}}</text>
        </view>
        <view class="field-row">
          <text class="field-label">处理原因</text>
          <textarea class="reason-input" value="{{reason}}" bindinput="onReasonInput"
                    placeholder="请填写处理原因" maxlength="500"></textarea>
        </view>
      </view>
    </block>
  </block>

  <!-- 提交中：按原键轮询，不重发 -->
  <view wx:if="{{viewState === 'processing'}}" class="card">
    <text class="field-label">{{tip}}</text>
    <view class="state-action" bindtap="onQueryTap">查看最新结果</view>
  </view>

  <!-- 结果态 -->
  <view wx:if="{{viewState === 'done'}}" class="card">
    <text class="field-label">{{tip}}</text>
    <view class="state-action" bindtap="onBackTap">返回列表</view>
  </view>

  <!-- 底部 CTA：决定按钮携带 GET 详情取到的版本字段 -->
  <view class="cta-bar" wx:if="{{viewState === 'content' && detail}}">
    <button class="btn-primary cta-btn" hover-class="cta-hover"
            disabled="{{detail.paused}}"
            data-action="PAUSE" data-version="{{detail.governanceVersion}}"
            bindtap="onDecideTap">暂停治理</button>
    <button class="btn-secondary cta-btn" hover-class="cta-hover"
            disabled="{{!detail.paused}}"
            data-action="RESTORE" data-version="{{detail.governanceVersion}}"
            bindtap="onDecideTap">解除治理</button>
  </view>
</view>
