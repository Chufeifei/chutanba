/* 页面专属样式；色值一律走 app.wxss 变量，圆角一律走 var(--radius-*) */
.page-shell.has-cta { padding-bottom: calc(376rpx + env(safe-area-inset-bottom)); }

.back-bar { margin-bottom: 24rpx; font-size: 28rpx; color: var(--color-text-muted); }

.field-row { margin-top: 24rpx; }
.field-label { font-size: 28rpx; color: var(--color-text); }
.field-value { font-size: 26rpx; color: var(--color-text-muted); }

/* 逐事实结论：每条事实一行，两个独立结论选项 */
.fact-card { margin-top: var(--space-gap); }
.fact-item { padding: 20rpx 0; border-bottom: 1rpx solid var(--color-border); }
.fact-item:last-child { border-bottom: 0; }
.fact-text { display: block; font-size: 26rpx; line-height: 40rpx; color: var(--color-text); }
.fact-options { display: flex; gap: 16rpx; margin-top: 16rpx; }
.fact-option { min-width: 160rpx; height: 64rpx; padding: 0 24rpx; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius-chip); background: var(--color-neutral-soft); color: var(--color-text-muted); font-size: 26rpx; }
.fact-option.active { background: var(--color-brand); color: var(--color-surface); }

.reason-input { margin-top: 12rpx; width: 100%; height: 72rpx; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid var(--color-border); border-radius: var(--radius-chip); background: var(--color-surface); color: var(--color-text); font-size: 26rpx; }

.notice { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: var(--radius-card); background: var(--color-brand-soft); color: var(--color-text); font-size: 26rpx; }

.card .divider { margin: 24rpx 0; }
.block-body { margin-top: 12rpx; font-size: 26rpx; line-height: 40rpx; color: var(--color-text-muted); }

/* 底部动作栏：页面内唯一固定栏 */
.cta-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 900; display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 16rpx var(--space-page) calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--color-border); background: var(--color-surface); box-sizing: border-box; }
/* 原生 button 重置：尺寸完全由语义类决定 */
.cta-btn { margin: 0; padding: 0; line-height: normal; }
.cta-hover { opacity: 0.85; }
