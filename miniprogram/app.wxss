page {
  min-height: 100%;
  background: #FAF8F5;
  color: #1F1F1F;
  font-family: "Sarasa Gothic SC", -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button { font-family: inherit; }
button::after { border: 0; }

.page-shell { min-height: 100vh; padding: 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.page-shell.with-fixed-cta { padding-bottom: calc(168rpx + env(safe-area-inset-bottom)); }
.surface-card { padding: 32rpx; border-radius: 32rpx; background: #FFFFFF; box-sizing: border-box; }
.surface-card + .surface-card { margin-top: 32rpx; }
.surface-sheet { border-radius: 48rpx 48rpx 0 0; background: #FFFFFF; }
.surface-hero { border-radius: 52rpx; background: #FFFFFF; }
.space-x16 { margin-top: 32rpx; }
.text-primary { color: #1F1F1F; }
.text-secondary { color: #6B6B6B; }
.text-brand { color: #FF7A45; }
.bg-brand { background: #FF7A45; color: #FFFFFF; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
