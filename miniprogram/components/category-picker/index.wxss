.category-bar { display: flex; white-space: nowrap; padding: 8rpx 0 16rpx; }
.category-chip { display: inline-flex; align-items: center; height: 64rpx; margin-right: 16rpx; padding: 0 24rpx; border-radius: 32rpx; background: var(--color-surface); font-size: 26rpx; color: var(--color-text-muted); }
.category-chip.is-active { background: var(--color-brand-soft); color: var(--color-brand); font-weight: 500; }
