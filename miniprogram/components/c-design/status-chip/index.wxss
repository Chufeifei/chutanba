@import "../../../styles/component-tokens.wxss";

/*
 * status-chip 样式。色值一律 var(--...)，变量由 component-tokens.wxss 单一真相源提供。
 * 自定义组件默认 styleIsolation=isolated，page 上的变量不会继承到组件根节点：
 * 首行 @import token 片段后，根节点挂 .c-token-host，变量即定义于根节点并向内继承。
 * tone 三态（neutral 默认 / success / warning）全部取 var(--color-*)；
 * 不写死任何色值，圆角只取 var(--radius-chip)。
 */
.c-status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 68rpx; /* 设计稿 64~72rpx 区间 */
  min-width: 96rpx;
  max-width: 100%;
  padding: 0 24rpx;
  border-radius: var(--radius-chip);
  background: var(--color-neutral-soft);
  overflow: visible; /* 文字不出框由 __text 的 ellipsis 保证；放开裁剪以承载透明热区 */
  box-sizing: border-box;
  position: relative;
}
/* 透明扩展热区：视觉 68rpx 高不变，实际可点区域 ≥88rpx */
.c-status-chip::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  min-width: 88rpx;
  height: 100%;
  min-height: 88rpx;
  transform: translate(-50%, -50%);
}
.c-status-chip__text {
  display: block;
  max-width: 100%;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis; /* 超长单行省略，不撑破胶囊 */
  color: var(--color-text-muted);
}
/* 三态色值全部走 token，与工作台 status-point / phase-badge 同口径 */
.c-status-chip.tone-success { background: var(--color-success-soft); }
.c-status-chip.tone-success .c-status-chip__text { color: var(--color-success); }
.c-status-chip.tone-warning { background: var(--color-warning-soft); }
.c-status-chip.tone-warning .c-status-chip__text { color: var(--color-warning); }

.c-status-chip.is-fluid { width: 100%; }
.c-status-chip.is-active {
  background: var(--color-brand);
}
.c-status-chip.is-active .c-status-chip__text {
  color: var(--color-surface);
}
.c-status-chip.is-disabled {
  opacity: 0.45;
}
