@import "../../../styles/component-tokens.wxss";

/*
 * nav-button 样式。色值一律 var(--...)，本文件不写死任何十六进制色值。
 * 三件复用组件均已按页面按需接线并在页面上实际生效，nav-button 已用于
 * 摊位卡与找摊首页；对外事件名已统一，点击一次只转成一次导航意图。
 * 色值、圆角均取自全局设计变量与组件 token 的同一份声明，变量在组件作用域内向
 * 子节点继承，视觉表现与样式隔离级别无关；早期与现状不符的自述已按现状更正。
 * 根节点透明扩展热区保持视觉 116×64rpx 不变，实际可点区域不小于 88rpx。
 */
.c-nav-button {
  width: 116rpx;
  height: 64rpx;
  border-radius: var(--radius-pill); /* 全圆角 */
  background: var(--color-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  position: relative;
}
/* 透明扩展热区：视觉 116×64rpx 不变，实际可点区域 ≥88rpx */
.c-nav-button::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  min-width: 88rpx;
  height: 100%;
  min-height: 88rpx;
  transform: translate(-50%, -50%);
}
.c-nav-button__text {
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
  color: var(--color-surface);
}
.c-nav-button.is-disabled {
  opacity: 0.5;
}
