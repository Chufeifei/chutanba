/* 组件样式隔离需显式重声明：page 上的变量在自定义组件内可能取不到 */
.state-view {
  --color-surface: #FFFFFF;
  --color-brand: #E07856;
  --color-brand-soft: #FDEDE5;
  --color-text: #5C5A55;
  --color-text-muted: #8A877F;
  --color-warning-soft: #FAEAD8;
  --color-warning: #D4A574;
  --color-neutral-soft: #F3F1EF;
}
/* 空/错/成功态白卡统一规格：686×400rpx、r16(32rpx)、插画 + 主文案 38rpx + 副文案 32rpx + CTA */
.state-view { width: 686rpx; height: 400rpx; margin: 32rpx auto; padding: 32rpx; border-radius: var(--radius-card); background: var(--color-surface); box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; overflow: hidden; }
.state-mark { width: 144rpx; height: 144rpx; margin: 0 auto 16rpx; border-radius: var(--radius-pill); display: flex; align-items: center; justify-content: center; background: var(--color-brand-soft); color: var(--color-brand); font-size: 44rpx; font-weight: 700; }
.state-title { color: var(--color-text); font-size: 38rpx; line-height: 1.3; font-weight: 500; }
.state-description { margin-top: 12rpx; color: var(--color-text-muted); font-size: 32rpx; line-height: 1.3; }
.state-action { min-width: 220rpx; height: 64rpx; margin: 16rpx auto 0; padding: 0 32rpx; border-radius: var(--radius-button); background: var(--color-brand); color: var(--color-surface); font-size: 28rpx; line-height: 64rpx; }

/* 需要用户注意的状态用警示色，避免和普通空态混淆 */
.tone-warning .state-mark { background: var(--color-warning-soft); color: var(--color-warning); }
.tone-neutral .state-mark { background: var(--color-neutral-soft); color: var(--color-text-muted); }

.state-spinner { width: 40rpx; height: 40rpx; border: 5rpx solid var(--color-brand-soft); border-top-color: var(--color-brand); border-radius: var(--radius-pill); animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
