.vendor-card { padding: 32rpx; border-radius: var(--radius-card); background: var(--color-surface); }
.vendor-card + .vendor-card { margin-top: 24rpx; }

.card-head { display: flex; align-items: center; justify-content: space-between; }
.vendor-name { flex: 1; margin-right: 16rpx; font-size: 34rpx; font-weight: 500; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.card-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; font-size: 26rpx; color: var(--color-text-muted); }
.meta-distance { color: var(--color-brand); font-weight: 500; }

.card-summary { margin-top: 16rpx; font-size: 28rpx; line-height: 42rpx; color: var(--color-text-muted); }

.card-foot { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 20rpx; font-size: 24rpx; line-height: 38rpx; color: var(--color-text-hint); }
.card-foot-info { display: flex; flex-direction: column; }
.foot-updated { margin-top: 4rpx; }

/* 116×64rpx 全圆角导航小按钮：catchtap 阻止冒泡，卡片整体仍可点 */
.nav-btn { flex: none; width: 116rpx; height: 64rpx; border-radius: 32rpx; background: var(--color-brand); color: var(--color-surface); display: flex; align-items: center; justify-content: center; font-size: 26rpx; }

.is-compact { padding: 24rpx 28rpx; }
.is-compact .vendor-name { font-size: 30rpx; }
