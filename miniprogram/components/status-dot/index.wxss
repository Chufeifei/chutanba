.status-row { display: inline-flex; align-items: center; gap: 12rpx; color: #6B6B6B; font-size: 26rpx; line-height: 36rpx; }
.status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #9AA0A6; flex: none; }
.status-positive .status-dot { background: #34C759; }
.status-warning .status-dot { background: #F5A623; }
.status-negative .status-dot { background: #E54D42; }
.status-brand .status-dot { background: #FF7A45; }
